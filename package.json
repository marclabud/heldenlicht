{
  "name": "agent-nuxt4-tw4-blueprint",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter frontend typecheck",
    "clean": "pnpm -r --if-present clean",
    "setup:backend": "uv venv --allow-existing Apps/Backend/.venv && uv pip install -r Apps/Backend/requirements.txt --python Apps/Backend/.venv/bin/python"
  }
}