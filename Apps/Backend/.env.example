# Google Gemini API Key (Required for live ADK 2.0 Agent Inference)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration (gemini-2.5-flash | gemini-2.5-pro | default)
LLM_MODEL=gemini-2.5-flash

# Backend Web Server Port
PORT=8000

# Audit Logging Provider (sqlite | firestore)
DB_PROVIDER=sqlite
